{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "toonstudio/episode.schema.json",
  "title": "Episódio",
  "description": "Contrato entre IA/roteiro e o pipeline. Tempos em segundos relativos ao início da cena; coordenadas em unidades de palco (1080 de altura, origem no canto superior esquerdo do cenário, y para baixo; personagens pelo ponto de apoio no chão).",
  "type": "object",
  "required": [
    "schema",
    "id",
    "title",
    "fps",
    "resolution",
    "background",
    "cast",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "logline": {
      "type": "string"
    },
    "fps": {
      "enum": [
        24,
        30
      ]
    },
    "resolution": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "background": {
      "type": "string"
    },
    "cast": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "character"
        ],
        "additionalProperties": false,
        "properties": {
          "character": {
            "type": "string"
          },
          "voice": {
            "$ref": "#/$defs/voice"
          }
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "track": {
          "type": "string"
        },
        "volume_db": {
          "type": "number"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storyboard": {
          "type": "boolean"
        },
        "final_render": {
          "type": "boolean"
        },
        "approved_by": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "soundtrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "start",
        "end"
      ],
      "description": "Clipe musical (1.1): áudio original intocado; trecho [start,end] em segundos da música.",
      "properties": {
        "file": {
          "type": "string"
        },
        "analysis": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number"
        },
        "fade_out": {
          "type": "number",
          "minimum": 0
        },
        "beat_grid": {
          "enum": [
            "full",
            "half"
          ]
        }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lyrics": {
          "type": "string"
        },
        "style": {
          "enum": [
            "palavra_a_palavra"
          ]
        }
      }
    },
    "overlays": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logo": {
          "type": "boolean"
        },
        "card": {
          "type": "string"
        },
        "footer": {
          "type": "string"
        },
        "card_dur": {
          "type": "number"
        },
        "channel": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  },
  "$defs": {
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "ref"
      ],
      "properties": {
        "provider": {
          "enum": [
            "higgs",
            "kokoro"
          ]
        },
        "ref": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pitch": {
          "type": "number",
          "minimum": -8,
          "maximum": 8
        },
        "tempo": {
          "type": "number",
          "minimum": 0.6,
          "maximum": 1.6
        },
        "formant": {
          "enum": [
            "preserved",
            "shifted"
          ]
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "id",
        "duration"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s[0-9]{2}[a-z0-9_-]*$"
        },
        "title": {
          "type": "string"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 60
        },
        "shot": {
          "enum": [
            "plano geral",
            "plano médio",
            "close",
            "plano conjunto",
            "detalhe",
            "plano americano"
          ]
        },
        "description": {
          "type": "string"
        },
        "camera": {
          "type": "object",
          "required": [
            "keys"
          ],
          "additionalProperties": false,
          "properties": {
            "keys": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "t",
                  "x",
                  "y",
                  "zoom"
                ],
                "additionalProperties": false,
                "properties": {
                  "t": {
                    "type": "number"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "zoom": {
                    "type": "number",
                    "minimum": 0.5,
                    "maximum": 3
                  },
                  "ease": {
                    "type": "string"
                  }
                }
              }
            },
            "shake": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "t",
                  "dur",
                  "amp"
                ],
                "additionalProperties": false,
                "properties": {
                  "t": {
                    "type": "number"
                  },
                  "dur": {
                    "type": "number"
                  },
                  "amp": {
                    "type": "number"
                  }
                }
              }
            },
            "beat": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "pulse": {
                  "type": "number"
                },
                "bar_zoom": {
                  "type": "number"
                },
                "sway": {
                  "type": "number"
                },
                "bounce": {
                  "type": "number"
                }
              }
            },
            "punch": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "t"
                ],
                "additionalProperties": false,
                "properties": {
                  "t": {
                    "type": "number"
                  },
                  "zoom": {
                    "type": "number"
                  },
                  "dur": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "characters": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/performance"
          }
        },
        "props": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/performance"
          }
        },
        "dialog": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "t",
              "who",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "t": {
                "type": "number"
              },
              "who": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "emotion": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "volume_db": {
                "type": "number"
              }
            }
          }
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "t",
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "t": {
                "type": "number"
              },
              "id": {
                "type": "string"
              },
              "volume_db": {
                "type": "number"
              },
              "pan": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            }
          }
        },
        "transition_out": {
          "enum": [
            "cut",
            "fade"
          ]
        },
        "background": {
          "type": "string"
        },
        "flash_in": {
          "type": "boolean"
        },
        "sing": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "who",
              "from",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "who": {
                "type": "string"
              },
              "from": {
                "type": "number"
              },
              "to": {
                "type": "number"
              }
            }
          }
        },
        "fx": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "enum": [
                  "bolhas",
                  "confete",
                  "estrelas",
                  "coracoes",
                  "notas"
                ]
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "bolhas",
                      "confete",
                      "estrelas",
                      "coracoes",
                      "notas"
                    ]
                  },
                  "count": {
                    "type": "integer"
                  },
                  "scale": {
                    "type": "number"
                  },
                  "seed": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false
              }
            ]
          }
        },
        "bg_pulse": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2
        },
        "transition_in": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "deslizar_esq",
                "deslizar_dir",
                "deslizar_cima",
                "deslizar_baixo",
                "cortina",
                "circulo",
                "zoom",
                "giro"
              ]
            },
            "dur": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 1.5
            }
          }
        },
        "callouts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "t",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "t": {
                "type": "number"
              },
              "text": {
                "type": "string"
              },
              "dur": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "color": {
                "enum": [
                  "amarelo",
                  "rosa",
                  "azul",
                  "verde",
                  "laranja"
                ]
              }
            }
          }
        },
        "layout": {
          "enum": [
            "diagonal",
            "vertical"
          ]
        },
        "panels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "camera",
              "characters"
            ],
            "properties": {
              "camera": {
                "type": "object",
                "required": [
                  "keys"
                ],
                "additionalProperties": false,
                "properties": {
                  "keys": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "t",
                        "x",
                        "y",
                        "zoom"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "t": {
                          "type": "number"
                        },
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        },
                        "zoom": {
                          "type": "number",
                          "minimum": 0.5,
                          "maximum": 3
                        },
                        "ease": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "shake": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "t",
                        "dur",
                        "amp"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "t": {
                          "type": "number"
                        },
                        "dur": {
                          "type": "number"
                        },
                        "amp": {
                          "type": "number"
                        }
                      }
                    }
                  },
                  "beat": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "pulse": {
                        "type": "number"
                      },
                      "bar_zoom": {
                        "type": "number"
                      },
                      "sway": {
                        "type": "number"
                      },
                      "bounce": {
                        "type": "number"
                      }
                    }
                  },
                  "punch": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "t"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "t": {
                          "type": "number"
                        },
                        "zoom": {
                          "type": "number"
                        },
                        "dur": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              },
              "characters": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/performance"
                }
              },
              "props": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/performance"
                }
              },
              "background": {
                "type": "string"
              },
              "fx": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "enum": [
                        "bolhas",
                        "confete",
                        "estrelas",
                        "coracoes",
                        "notas"
                      ]
                    },
                    {
                      "type": "object",
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "enum": [
                            "bolhas",
                            "confete",
                            "estrelas",
                            "coracoes",
                            "notas"
                          ]
                        },
                        "count": {
                          "type": "integer"
                        },
                        "scale": {
                          "type": "number"
                        },
                        "seed": {
                          "type": "integer"
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "sing": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "who",
                    "from",
                    "to"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "who": {
                      "type": "string"
                    },
                    "from": {
                      "type": "number"
                    },
                    "to": {
                      "type": "number"
                    }
                  }
                }
              },
              "bg_pulse": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.2
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "object"
        },
        "keys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "t"
            ],
            "additionalProperties": false,
            "properties": {
              "t": {
                "type": "number"
              },
              "pose": {
                "type": "object"
              },
              "expr": {
                "type": "string"
              },
              "amount": {
                "type": "number"
              },
              "ease": {
                "type": "string"
              },
              "in": {
                "type": "number",
                "minimum": 0,
                "description": "duração da transição até a chave (s); o valor anterior segura até t-in"
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "t",
              "do"
            ],
            "properties": {
              "t": {
                "type": "number"
              },
              "do": {
                "type": "string"
              }
            }
          }
        },
        "exposure": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "z": {
          "type": "integer"
        }
      }
    }
  }
}